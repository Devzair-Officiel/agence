# =============================================================================
# Devzair — Variables d'environnement de PRODUCTION (Phase 12)
# =============================================================================
#
# CE FICHIER EST UN TEMPLATE. Ne jamais versionner le fichier réel .env.prod
# (il contient des secrets). Copier et adapter sur le VPS :
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#   # éditer .env.prod avec les vraies valeurs
#
# Utilisation :
#   docker compose -f compose.prod.yaml --env-file .env.prod up -d
#
# =============================================================================

# ── Frontend Nuxt — BUILD TIME + RUNTIME ─────────────────────────────────────
#
# ⚠  Les 3 variables ci-dessous sont lues À LA FOIS :
#    - au BUILD Docker (stage builder de Dockerfile.prod via compose build.args)
#      → baked dans le HTML des pages pré-rendues (/, /agence, /contact, /expertises)
#      → canonical, og:url, og:image, JSON-LD Organization/WebSite
#      → meta robots (<meta name="robots" content="index, follow">)
#    - au RUNTIME (Nitro lit NUXT_PUBLIC_* au démarrage)
#      → robots.txt dynamique, sitemap.xml dynamique, SSR non pré-rendu
#
# Si elles ne sont pas correctement définies au BUILD, les pages statiques
# contiendront "http://localhost:3001" et "noindex" dans le HTML servi aux crawlers.
# Le Dockerfile.prod échoue explicitement si NUXT_PUBLIC_SITE_URL = localhost.

# URL publique canonique (sans trailing slash).
NUXT_PUBLIC_SITE_URL=https://devzair.fr

# true = le site est indexable (production).
NUXT_PUBLIC_SITE_INDEXABLE=true

# URL relative : le navigateur appelle /api/... → Caddy global route vers api.
NUXT_PUBLIC_API_BASE_URL=/api

# URL privée Nitro → Symfony, sur le réseau interne Docker (sans passer par Caddy).
# Symfony reçoit les routes sans le préfixe /api (strip_prefix côté Caddy global).
NUXT_EDITORIAL_API_BASE_URL=http://api:8000

# Cloudflare Turnstile (phase 6C). Clé publique du widget.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=<votre-clé-site-turnstile>

# true en production si Turnstile est activé côté API.
NUXT_PUBLIC_TURNSTILE_ENABLED=true

# ── Backend Symfony ──────────────────────────────────────────────────────────

# Clé secrète Symfony (min. 32 caractères aléatoires). Générer avec :
#   php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
APP_SECRET=<32-chars-random-hex>

# DSN Mailer OVHcloud SMTP (voir ADR-008 / Phase 6C).
# Format : smtp://user:password@ssl0.ovh.net:465?encryption=ssl
MAILER_DSN=smtp://<user>:<password>@<host>:<port>

CONTACT_FROM_EMAIL=no-reply@devzair.fr
CONTACT_FROM_NAME=Devzair — Site
# Adresse qui reçoit les demandes de contact.
CONTACT_RECIPIENT=contact@devzair.fr

# URL publique de base de l'administration Symfony (sans slash final).
# Utilisée pour construire les liens absolus dans les emails de notification
# des leads estimateur et des propositions de partenariat.
# En prod : https://votre-domaine.tld  (même origine que l'admin /admin/*)
# Vide par défaut : les liens dans les emails de notification seront incomplets.
APP_ADMIN_BASE_URL=

# Liste des origins autorisées à soumettre le formulaire de contact (virgule).
# Doit correspondre exactement à NUXT_PUBLIC_SITE_URL.
CONTACT_ORIGIN_ALLOWLIST=https://devzair.fr

# Cloudflare Turnstile : clé secrète (server-side).
TURNSTILE_ENABLED=true
TURNSTILE_SECRET=<votre-clé-secrète-turnstile>

# Rate limiting contact (5 tentatives / 10 min par IP).
CONTACT_RATE_LIMIT=5
CONTACT_RATE_INTERVAL=10 minutes

# Proxies de confiance. REMOTE_ADDR = faire confiance au seul upstream direct
# (le Caddy global). Ne pas mettre d'IP fixe (peut changer en Docker).
TRUSTED_PROXIES=REMOTE_ADDR
TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-host,x-forwarded-port

# Session admin (durée en secondes : 28800 = 8 heures).
ADMIN_SESSION_LIFETIME=28800

# ── PostgreSQL ────────────────────────────────────────────────────────────────

POSTGRES_DB=devzair
POSTGRES_USER=devzair
# Mot de passe fort. Générer avec : openssl rand -base64 32
POSTGRES_PASSWORD=<strong-password>

# DSN Doctrine. serverVersion=17 évite un ping runtime (voir ADR-009).
DATABASE_URL=postgresql://devzair:<strong-password>@postgres:5432/devzair?serverVersion=17&charset=utf8

# ── Médias éditoriaux ─────────────────────────────────────────────────────────

# Répertoire de stockage des médias (volume api_media monté ici).
EDITORIAL_MEDIA_STORAGE_DIR=/app/var/editorial-media

# Upload admin : 20 fichiers / 10 minutes par session admin.
ADMIN_MEDIA_UPLOAD_LIMIT=20
ADMIN_MEDIA_UPLOAD_INTERVAL=10 minutes

# ── Intégrations optionnelles ─────────────────────────────────────────────────

# Token n8n pour création automatisée de brouillons. Vide = endpoint désactivé.
N8N_EDITORIAL_TOKEN=

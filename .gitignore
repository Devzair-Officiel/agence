# Node
node_modules/

# Nuxt / Nitro
.nuxt/
.output/
.data/
.nitro/
.cache/

# Tests et rapports
coverage/
playwright-report/
test-results/

# Fichiers d'environnement (garder uniquement l'exemple)
.env
.env.*
!.env.example
!.env.prod.example
# apps/api/.env contient uniquement APP_ENV=dev (aucun secret) et est requis
# par Symfony (Dotenv::bootEnv) aussi bien en local qu'en CI. Ce fichier DOIT
# être versionné — sans lui, bin/console lève PathException au démarrage.
!apps/api/.env

# OS / IDE
.DS_Store
.idea/
.vscode/

# Fichier local historique
.env.local.dev

# Claude Code — état local d'agent (verrous de boucle autonome, préférences
# locales du poste). Toute config projet volontairement versionnée dans
# `.claude/` (ex. `.claude/rules/`, `.claude/agents/`) reste trackable —
# seules les entrées ci-dessous sont exclues.
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Claude Code — worktrees temporaires locaux
.claude/worktrees/
# =============================================================================
# Contrat Symfony minimal (dev)
# =============================================================================
#
# Fichier obligatoire pour Symfony (Dotenv::bootEnv appelé au démarrage de
# `bin/console` et du front controller). Il ne doit contenir AUCUN secret
# ni aucune valeur de configuration réelle — toutes les vraies valeurs sont
# injectées par Docker Compose depuis `.env` à la racine du monorepo.
#
# Cascade Symfony :
#   .env → .env.local → .env.$APP_ENV → .env.$APP_ENV.local
#   Les vraies variables d'environnement (injectées par Docker) l'emportent
#   toujours sur les fichiers .env — c'est ce qui permet à ce fichier de
#   rester vide en dev.
#
# NE PAS ajouter de secrets ici. NE PAS remplir MAILER_DSN, APP_SECRET, etc.
# =============================================================================

APP_ENV=dev

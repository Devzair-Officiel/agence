{
    "name": "devzair/api",
    "description": "Devzair — API Symfony 7.4 LTS (Phase 6A : endpoint /api/contact, Phase 8A : domaine éditorial PostgreSQL).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo_pgsql": "*",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.3",
        "league/commonmark": "^2.7",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2.4",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^3.10",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4",
        "symfony/browser-kit": "7.4.*",
        "symfony/phpunit-bridge": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test:cache:clear": "@php bin/console cache:clear --env=test --no-warmup",
        "test:db:reset": [
            "@php bin/console doctrine:database:create --if-not-exists --env=test",
            "@php bin/console doctrine:migrations:migrate --no-interaction --env=test"
        ],
        "test:schema:validate": "@php bin/console doctrine:schema:validate --env=test",
        "test": [
            "@test:cache:clear",
            "@test:db:reset",
            "@php vendor/bin/phpunit"
        ]
    },
    "scripts-descriptions": {
        "test:cache:clear": "Invalide le cache Symfony env=test avant PHPUnit (routes, container, DI). Requis après toute modification de routing/config test.",
        "test:db:reset": "Crée la base test si absente puis applique toutes les migrations. Idempotent.",
        "test:schema:validate": "Vérifie que le mapping Doctrine et le schéma SQL de la base test sont synchronisés (sans --skip-sync).",
        "test": "Pipeline PHPUnit reproductible : cache test invalidé → schéma migré → suite exécutée."
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}

{% extends 'admin/_layout.html.twig' %}

{% block title %}Articles — Administration Devzair{% endblock %}

{% block body %}
    <div class="page-header">
        <h1>Articles</h1>
        <a href="{{ path('admin_article_create') }}" class="button-link button-primary">
            Nouveau brouillon
        </a>
    </div>

    <section class="card">
        <form method="get" action="{{ path('admin_articles_list') }}" class="filter-form">
            <label for="filter-status">Filtrer par statut</label>
            <select id="filter-status" name="status">
                <option value="">Tous</option>
                {% for status in status_options %}
                    <option value="{{ status.value }}" {{ current_status == status ? 'selected' : '' }}>
                        {% if status.value == 'draft' %}Brouillons
                        {% elseif status.value == 'published' %}Publiés
                        {% else %}Archivés
                        {% endif %}
                    </option>
                {% endfor %}
            </select>
            <button type="submit">Appliquer</button>
        </form>

        {% if result.items is empty %}
            <p class="empty-state">Aucun article ne correspond à ce filtre.</p>
        {% else %}
            <table class="admin-table">
                <caption class="visually-hidden">
                    Liste des articles — page {{ result.page }} sur {{ result.lastPage() }},
                    {{ result.total }} article{{ result.total > 1 ? 's' : '' }} au total.
                </caption>
                <thead>
                    <tr>
                        <th scope="col">Titre</th>
                        <th scope="col">Slug</th>
                        <th scope="col">Statut</th>
                        <th scope="col">Mis à jour (UTC)</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in result.items %}
                        <tr>
                            <td>{{ item.title }}</td>
                            <td><code>{{ item.slug }}</code></td>
                            <td>
                                <span class="status-badge status-{{ item.status.value }}">
                                    {% if item.status.value == 'draft' %}Brouillon
                                    {% elseif item.status.value == 'published' %}Publié
                                    {% else %}Archivé
                                    {% endif %}
                                </span>
                            </td>
                            <td>
                                <time datetime="{{ item.updatedAt|date('c') }}">
                                    {{ item.updatedAt|date('Y-m-d H:i') }}
                                </time>
                            </td>
                            <td>
                                {% include 'admin/articles/_row_actions.html.twig' with { item: item } only %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            <nav class="pagination" aria-label="Pagination des articles">
                <p class="pagination-summary">
                    Page {{ result.page }} sur {{ result.lastPage() }} — {{ result.total }} article{{ result.total > 1 ? 's' : '' }}.
                </p>
                <ul class="pagination-links">
                    {% if result.hasPrevious() %}
                        <li>
                            <a href="{{ path('admin_articles_list', { page: result.page - 1, status: current_status ? current_status.value : null }) }}">
                                ← Précédent
                            </a>
                        </li>
                    {% endif %}
                    {% if result.hasNext() %}
                        <li>
                            <a href="{{ path('admin_articles_list', { page: result.page + 1, status: current_status ? current_status.value : null }) }}">
                                Suivant →
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
        {% endif %}
    </section>
{% endblock %}

{% extends 'admin/_layout.html.twig' %}

{% block title %}Articles — Administration Devzair{% endblock %}

{% block workspace_inner_modifier %}admin-workspace__inner--wide{% endblock %}

{#
    Rendu d'un en-tête de colonne triable.
    Paramètres :
      - sort_key        : valeur du param `sort` pour cette colonne ;
      - current_sort    : tri actuel ;
      - current_direction : direction actuelle (asc|desc) ;
      - default_dir     : direction par défaut si la colonne n'est pas active ;
      - current_status  : filtre statut ou null.
#}
{% macro th_sort(label, sort_key, current_sort, current_direction, default_dir, current_status) %}
    {%- set _is_active = (current_sort == sort_key) -%}
    {%- set _next_dir  = _is_active ? (current_direction == 'asc' ? 'desc' : 'asc') : default_dir -%}
    {%- set _aria_sort = _is_active ? (current_direction == 'asc' ? 'ascending' : 'descending') : 'none' -%}
    <th scope="col"
        class="admin-th-sort"
        aria-sort="{{ _aria_sort }}">
        <a href="{{ path('admin_articles_list', {
            sort:      sort_key,
            direction: _next_dir,
            status:    current_status ? current_status.value : null,
        }) }}">{{ label }}</a>
    </th>
{% endmacro %}

{% block body %}
{% import _self as list_macros %}
<div class="admin-articles-page">

    {# ── En-tête ─────────────────────────────────────────────────────────── #}
    <header class="admin-page-header">
        <div class="admin-page-header__titles">
            <h1 class="admin-page-header__title">Articles</h1>
            <p class="admin-page-header__subtitle">Gérez les contenus éditoriaux de Devzair.</p>
        </div>
        <div class="admin-page-header__actions">
            <a href="{{ path('admin_article_create') }}"
               class="button-link button-primary">
                + Nouveau brouillon
            </a>
        </div>
    </header>

    {# ── Filtres nav ─────────────────────────────────────────────────────── #}
    <nav class="admin-article-filters" aria-label="Filtrer les articles par statut">
        <ul role="list">
            <li>
                <a href="{{ path('admin_articles_list', { sort: current_sort, direction: current_direction }) }}"
                   class="admin-article-filter{% if current_status is null %} admin-article-filter--active{% endif %}"
                   {% if current_status is null %}aria-current="page"{% endif %}>
                    Tous
                </a>
            </li>
            <li>
                <a href="{{ path('admin_articles_list', { status: 'published', sort: current_sort, direction: current_direction }) }}"
                   class="admin-article-filter{% if current_status is not null and current_status.value == 'published' %} admin-article-filter--active{% endif %}"
                   {% if current_status is not null and current_status.value == 'published' %}aria-current="page"{% endif %}>
                    Publiés
                </a>
            </li>
            <li>
                <a href="{{ path('admin_articles_list', { status: 'draft', sort: current_sort, direction: current_direction }) }}"
                   class="admin-article-filter{% if current_status is not null and current_status.value == 'draft' %} admin-article-filter--active{% endif %}"
                   {% if current_status is not null and current_status.value == 'draft' %}aria-current="page"{% endif %}>
                    Brouillons
                </a>
            </li>
            <li>
                <a href="{{ path('admin_articles_list', { status: 'archived', sort: current_sort, direction: current_direction }) }}"
                   class="admin-article-filter{% if current_status is not null and current_status.value == 'archived' %} admin-article-filter--active{% endif %}"
                   {% if current_status is not null and current_status.value == 'archived' %}aria-current="page"{% endif %}>
                    Archivés
                </a>
            </li>
        </ul>
    </nav>

    {# ── Tableau / état vide ─────────────────────────────────────────────── #}
    {% if result.items is empty %}
        <div class="admin-articles-empty">
            <p class="admin-articles-empty__msg">
                {%- if current_status is not null -%}
                    Aucun article ne correspond à ce filtre.
                {%- else -%}
                    Aucun article pour le moment.
                {%- endif -%}
            </p>
            {% if current_status is null %}
                <a href="{{ path('admin_article_create') }}"
                   class="button-link button-primary">
                    + Nouveau brouillon
                </a>
            {% endif %}
        </div>
    {% else %}
        <div class="admin-table-scroll">
            <table class="admin-table">
                <caption class="visually-hidden">
                    Liste des articles — page {{ result.page }} sur {{ result.lastPage() }},
                    {{ result.total }} article{{ result.total > 1 ? 's' : '' }} au total.
                </caption>
                <thead>
                    <tr>
                        {{ list_macros.th_sort('ID',      'id',         current_sort, current_direction, 'asc',  current_status) }}
                        {{ list_macros.th_sort('Article', 'title',      current_sort, current_direction, 'asc',  current_status) }}
                        {{ list_macros.th_sort('Statut',  'status',     current_sort, current_direction, 'asc',  current_status) }}
                        {{ list_macros.th_sort('Modifié', 'updated_at', current_sort, current_direction, 'desc', current_status) }}
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in result.items %}
                        <tr>
                            <td data-label="ID">
                                <code class="admin-article-id"
                                      title="{{ item.id }}">{{ item.id|slice(0, 8) }}…</code>
                            </td>
                            <td class="admin-article-cell" data-label="Article">
                                <p class="admin-article-title">{{ item.title }}</p>
                                <code class="admin-article-slug">{{ item.slug }}</code>
                            </td>
                            <td data-label="Statut">
                                <span class="status-badge status-{{ item.status.value }}">
                                    {% if item.status.value == 'draft' %}Brouillon
                                    {% elseif item.status.value == 'published' %}Publié
                                    {% else %}Archivé
                                    {% endif %}
                                </span>
                            </td>
                            <td data-label="Modifié">
                                <time datetime="{{ item.updatedAt|date('c') }}">
                                    {{ item.updatedAt|date('d/m/Y · H:i') }}
                                </time>
                            </td>
                            <td data-label="Actions">
                                {% include 'admin/articles/_row_actions.html.twig' with { item: item } only %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <nav class="pagination" aria-label="Pagination des articles">
            <p class="pagination-summary">
                Page {{ result.page }} sur {{ result.lastPage() }} — {{ result.total }} article{{ result.total > 1 ? 's' : '' }}.
            </p>
            <ul class="pagination-links">
                {% if result.hasPrevious() %}
                    <li>
                        <a href="{{ path('admin_articles_list', {
                            page:      result.page - 1,
                            status:    current_status ? current_status.value : null,
                            sort:      current_sort,
                            direction: current_direction,
                        }) }}">← Précédent</a>
                    </li>
                {% endif %}
                {% if result.hasNext() %}
                    <li>
                        <a href="{{ path('admin_articles_list', {
                            page:      result.page + 1,
                            status:    current_status ? current_status.value : null,
                            sort:      current_sort,
                            direction: current_direction,
                        }) }}">Suivant →</a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}

</div>
{% endblock %}

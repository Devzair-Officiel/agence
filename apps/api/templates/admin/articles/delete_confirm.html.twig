{% extends 'admin/_layout.html.twig' %}

{%- set _status_fr = {'draft': 'Brouillon', 'published': 'Publié', 'archived': 'Archivé'} -%}

{% block title %}Supprimer définitivement — Administration Devzair{% endblock %}

{% block body %}
<div class="admin-editor-page">

    <header class="admin-page-header">
        <div class="admin-page-header__titles">
            <h1 class="admin-page-header__title">Supprimer définitivement cet article&nbsp;?</h1>
            <p class="admin-page-header__subtitle">
                <code class="admin-editor-slug">{{ view.slug }}</code>
            </p>
        </div>
        <div class="admin-page-header__actions">
            <a href="{{ path('admin_article_edit', { id: view.id }) }}" class="button-link">
                ← Retour à l'article
            </a>
        </div>
    </header>

    <div class="admin-editor-grid">
        <main class="admin-editor-main">

            <div class="admin-editor-card">
                <p class="admin-delete-warning">
                    Cette action est irréversible. L'article et les données qui lui sont
                    exclusivement rattachées ne pourront pas être restaurés.
                </p>

                <dl class="admin-publication-card__meta">
                    <dt>Titre</dt>
                    <dd>{{ view.title }}</dd>
                    <dt>Statut</dt>
                    <dd>{{ _status_fr[view.status.value] ?? view.status.value|capitalize }}</dd>
                    {% if view.publishedAt %}
                        <dt>Première publication</dt>
                        <dd>
                            <time datetime="{{ view.publishedAt|date('c') }}">
                                {{ view.publishedAt|date('d/m/Y · H:i') }}
                            </time>
                        </dd>
                    {% endif %}
                </dl>

                <div class="admin-delete-confirm__actions">
                    <a href="{{ path('admin_article_edit', { id: view.id }) }}"
                       class="button-link">
                        Annuler
                    </a>

                    <form method="post"
                          action="{{ path('admin_article_delete', { id: view.id }) }}"
                          class="inline-form">
                        <input type="hidden" name="_csrf_token"
                               value="{{ csrf_token('article_delete_' ~ view.id) }}">
                        <button type="submit" class="button-danger">
                            Supprimer définitivement
                        </button>
                    </form>
                </div>
            </div>

        </main>
    </div>

</div>
{% endblock %}

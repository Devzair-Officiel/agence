{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ view.title }} — Modifier — Administration Devzair{% endblock %}

{%- set _status_fr = {'draft': 'Brouillon', 'published': 'Publié', 'archived': 'Archivé'} -%}
{%- set _is_draft     = view.status.value == 'draft' -%}
{%- set _is_published = view.status.value == 'published' -%}
{%- set _pillars = [
    { id: 'concevoir',     label: 'Concevoir' },
    { id: 'construire',    label: 'Construire' },
    { id: 'valoriser',     label: 'Valoriser' },
    { id: 'visibilite',    label: 'Visibilité' },
    { id: 'faire-evoluer', label: 'Faire évoluer' },
] -%}

{% block body %}
<div class="admin-editor-page">

    {# ── En-tête ─────────────────────────────────────────────────────────── #}
    <header class="admin-page-header">
        <div class="admin-page-header__titles">
            <h1 class="admin-page-header__title">Modifier l'article</h1>
            <p class="admin-page-header__subtitle">
                <code class="admin-editor-slug">{{ view.slug }}</code>
            </p>
        </div>
        <div class="admin-page-header__actions">
            <a href="{{ path('admin_articles_list') }}" class="button-link">
                ← Retour aux articles
            </a>
        </div>
    </header>

    {# ── Grille : sidebar (DOM en premier → mobile en haut) + main ───────── #}
    <div class="admin-editor-grid">

        {# ══════════════════════════════════════════════════════════════════
           RAIL LATÉRAL
           Premier dans le DOM → Publication visible avant le Markdown sur mobile.
           Sur desktop : CSS order le déplace visuellement à droite.
           ══════════════════════════════════════════════════════════════════ #}
        <aside class="admin-editor-sidebar">

            {# ── Bloc Publication ────────────────────────────────────────── #}
            <div class="admin-editor-card admin-publication-card">
                <h2 class="admin-publication-card__heading">Publication</h2>

                <div class="admin-publication-card__status">
                    <span class="status-badge status-{{ view.status.value }}">
                        {{ _status_fr[view.status.value] ?? view.status.value|capitalize }}
                    </span>
                </div>

                <dl class="admin-publication-card__meta">
                    {% if _is_draft %}
                        <dt>Modifié le</dt>
                        <dd>
                            <time datetime="{{ view.updatedAt|date('c') }}">
                                {{ view.updatedAt|date('d/m/Y · H:i') }}
                            </time>
                        </dd>
                    {% elseif _is_published %}
                        {% if view.publishedAt %}
                            <dt>Publié le</dt>
                            <dd>
                                <time datetime="{{ view.publishedAt|date('c') }}">
                                    {{ view.publishedAt|date('d/m/Y · H:i') }}
                                </time>
                            </dd>
                        {% endif %}
                        <dt>Modifié le</dt>
                        <dd>
                            <time datetime="{{ view.updatedAt|date('c') }}">
                                {{ view.updatedAt|date('d/m/Y · H:i') }}
                            </time>
                        </dd>
                    {% endif %}
                </dl>

                <div class="admin-publication-card__actions">
                    {% if _is_draft %}
                        <form method="post"
                              action="{{ path('admin_article_publish', { id: view.id }) }}"
                              class="inline-form">
                            <input type="hidden" name="_csrf_token"
                                   value="{{ csrf_token('article_publish_' ~ view.id) }}">
                            <button type="submit" class="button-small button-primary">
                                Publier ce brouillon
                            </button>
                        </form>
                        <form method="post"
                              action="{{ path('admin_article_archive', { id: view.id }) }}"
                              class="inline-form">
                            <input type="hidden" name="_csrf_token"
                                   value="{{ csrf_token('article_archive_' ~ view.id) }}">
                            <button type="submit" class="button-small button-danger-subtle">
                                Archiver et retirer du site public
                            </button>
                        </form>
                    {% elseif _is_published %}
                        <p class="admin-publication-card__note">
                            Article publié. L'édition du contenu est verrouillée.
                        </p>
                        <form method="post"
                              action="{{ path('admin_article_archive', { id: view.id }) }}"
                              class="inline-form">
                            <input type="hidden" name="_csrf_token"
                                   value="{{ csrf_token('article_archive_' ~ view.id) }}">
                            <button type="submit" class="button-small button-danger-subtle">
                                Archiver et retirer du site public
                            </button>
                        </form>
                    {% else %}
                        <p class="admin-publication-card__note">
                            Article archivé.
                        </p>
                        <form method="post"
                              action="{{ path('admin_article_restore', { id: view.id }) }}"
                              class="inline-form">
                            <input type="hidden" name="_csrf_token"
                                   value="{{ csrf_token('article_restore_' ~ view.id) }}">
                            <button type="submit" class="button-small">
                                Restaurer comme brouillon
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>

            {# ── Actions : Enregistrer + Prévisualiser ───────────────────── #}
            <div class="admin-editor-card admin-editor-actions">
                {#
                    Le bouton est hors du <form id="article-edit-form"> ;
                    l'attribut form= l'associe au formulaire d'édition
                    sans imbriquer des formulaires.
                #}
                {% if _is_draft %}
                    <button type="submit" form="article-edit-form" class="button-primary">
                        Enregistrer les modifications
                    </button>
                {% endif %}
                <a href="{{ path('admin_article_preview', { id: view.id }) }}"
                   class="button-link">
                    Prévisualiser
                </a>
            </div>

            {# ── Image principale ─────────────────────────────────────────── #}
            <div class="admin-editor-card admin-editor-hero">
                <h2 class="admin-editor-card__heading">Image principale</h2>

                {% if view.heroImage %}
                    <figure class="admin-editor-hero__figure">
                        <img class="admin-editor-hero__image"
                             src="{{ path('admin_media_preview', { id: view.heroImage.mediaId }) }}"
                             alt="{{ view.heroImage.altText }}"
                             width="{{ view.heroImage.width }}"
                             height="{{ view.heroImage.height }}"
                             loading="lazy">
                        <figcaption class="admin-editor-hero__caption">
                            <span class="admin-editor-hero__alt">{{ view.heroImage.altText }}</span>
                            <span class="admin-editor-hero__dims">
                                {{ view.heroImage.width }}&nbsp;×&nbsp;{{ view.heroImage.height }}&nbsp;px
                            </span>
                        </figcaption>
                    </figure>

                    {% if _is_draft %}
                        <div class="admin-editor-hero__actions">
                            <a href="{{ path('admin_article_hero_image', { id: view.id }) }}"
                               class="button-link button-small">Modifier</a>
                            {# Formulaire séparé — ne s'imbrique pas dans article-edit-form #}
                            <form method="post"
                                  action="{{ path('admin_article_hero_image_remove', { id: view.id }) }}"
                                  class="inline-form">
                                <input type="hidden" name="_csrf_token"
                                       value="{{ csrf_token('article_hero_image_remove_' ~ view.id) }}">
                                <button type="submit" class="button-small button-danger-subtle">Retirer</button>
                            </form>
                        </div>
                    {% else %}
                        <p class="admin-editor-hero__locked">
                            Modifiable uniquement à l'état brouillon.
                        </p>
                    {% endif %}
                {% else %}
                    <p class="admin-editor-hero__empty">Aucune image principale.</p>
                    {% if _is_draft %}
                        <a href="{{ path('admin_article_hero_image', { id: view.id }) }}"
                           class="button-link button-small">Choisir une image</a>
                    {% endif %}
                {% endif %}
            </div>

            {# ── SEO, Expertises, Auteur (brouillon uniquement, form= attribute) #}
            {% if _is_draft %}
                {% include 'admin/articles/_fields_metadata.html.twig' with {
                    form_id: 'article-edit-form',
                    data: data,
                    errors: errors,
                    _pillars: _pillars,
                } only %}
            {% endif %}{# end _is_draft sidebar fields #}

        </aside>{# end .admin-editor-sidebar #}

        {# ══════════════════════════════════════════════════════════════════
           ZONE PRINCIPALE
           Deuxième dans le DOM → après la sidebar sur mobile.
           Sur desktop : CSS order le place à gauche (colonne 1fr).
           ══════════════════════════════════════════════════════════════════ #}
        <main class="admin-editor-main">

            {% if _is_draft %}
                {#
                    Formulaire d'édition principal.
                    id="article-edit-form" : les champs du rail latéral
                    (SEO, Expertises, Auteur) y sont associés via form=.
                    Aucun autre <form> ne peut s'imbriquer ici.
                #}
                <form id="article-edit-form" class="article-form" method="post"
                      action="{{ path('admin_article_edit', { id: view.id }) }}" novalidate>
                    <input type="hidden" name="_csrf_token"
                           value="{{ csrf_token('article_edit_' ~ view.id) }}">

                    {% for message in errors.global %}
                        <div class="alert alert-error" role="alert">{{ message }}</div>
                    {% endfor %}

                    {% include 'admin/articles/_fields_main.html.twig' with {
                        is_create: false,
                        data: data,
                        errors: errors,
                    } only %}

                    {# Bouton visible uniquement sur mobile (le rail sticky prend le relai sur desktop) #}
                    <div class="form-actions admin-editor-save-mobile">
                        <button type="submit">Enregistrer les modifications</button>
                    </div>
                </form>

            {% elseif _is_published %}

                <div class="admin-editor-locked">
                    <h2 class="admin-editor-locked__title">Contenu verrouillé</h2>
                    <p class="admin-editor-locked__body">
                        Cet article est publié. Pour modifier son contenu, archivez-le
                        puis restaurez-le en brouillon.
                    </p>
                </div>

            {% else %}

                <div class="admin-editor-locked">
                    <h2 class="admin-editor-locked__title">Article archivé</h2>
                    <p class="admin-editor-locked__body">
                        Restaurez cet article comme brouillon pour reprendre l'édition.
                    </p>
                </div>

            {% endif %}

        </main>{# end .admin-editor-main #}

    </div>{# end .admin-editor-grid #}

</div>{# end .admin-editor-page #}
{% endblock %}

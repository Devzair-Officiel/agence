{% extends 'admin/_layout.html.twig' %}

{% block title %}Leads estimateur — Administration Devzair{% endblock %}

{% block body %}
{# ── Mappings humains (source unique pour ce template) ──────────────────── #}
{% set projectTypeLabels = {
    'vitrinesite': 'Site vitrine',
    'ecommerce':   'E-commerce',
    'businessapp': 'Application métier',
    'refonte':     'Refonte',
    'other':       'Autre projet',
    'unknown':     'Projet à cadrer'
} %}

{# ── En-tête de page ────────────────────────────────────────────────────── #}
<div class="admin-page-header">
    <div class="admin-page-header__titles">
        <h1 class="admin-page-header__title">Leads estimateur</h1>
        <p class="admin-page-header__subtitle">Demandes transmises depuis l&rsquo;estimateur de projet.</p>
        <p class="admin-page-count">{{ leads|length }} demande{{ leads|length != 1 ? 's' }}</p>
    </div>
</div>

{# ── Tableau ou état vide ─────────────────────────────────────────────── #}
{% if leads is empty %}
    <p class="admin-empty-state">Aucune demande reçue pour le moment.</p>
{% else %}
<div class="admin-table-scroll">
    <table class="admin-table" aria-label="Liste des leads estimateur">
        <thead>
            <tr>
                <th scope="col">Date</th>
                <th scope="col">Contact</th>
                <th scope="col">Entreprise</th>
                <th scope="col">Projet</th>
                <th scope="col">Estimation</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
        {% for lead in leads %}
            <tr>
                {# Date #}
                <td data-label="Date">{{ lead.createdAt|date('d/m/Y à H:i') }}</td>

                {# Contact : nom + email deux lignes #}
                <td data-label="Contact">
                    <div class="admin-table-contact">
                        <span class="admin-table-contact__name">{{ lead.name|e }}</span>
                        <span class="admin-table-contact__email">{{ lead.email|e }}</span>
                    </div>
                </td>

                {# Entreprise #}
                <td data-label="Entreprise">{{ lead.company ? lead.company|e : '—' }}</td>

                {# Projet : label humain #}
                <td data-label="Projet">
                    {{ projectTypeLabels[lead.projectType] ?? lead.projectType|e }}
                </td>

                {# Estimation #}
                <td data-label="Estimation">
                    {% if lead.outcome == 'estimated' and lead.estimateMinimumMinor is not null %}
                        <span class="admin-estimate-range">
                            {{ (lead.estimateMinimumMinor / 100)|number_format(0, ',', ' ') }}&nbsp;&euro;
                            &ndash;
                            {{ (lead.estimateMaximumMinor / 100)|number_format(0, ',', ' ') }}&nbsp;&euro;
                        </span>
                    {% elseif lead.outcome == 'human_scoping_required' %}
                        <span class="admin-badge admin-badge--neutral">À cadrer</span>
                    {% else %}
                        &mdash;
                    {% endif %}
                </td>

                {# Action #}
                <td data-label="Action">
                    <a href="{{ path('admin_leads_show', {id: lead.id.toRfc4122}) }}"
                       class="admin-action-link">
                        Voir le projet
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}

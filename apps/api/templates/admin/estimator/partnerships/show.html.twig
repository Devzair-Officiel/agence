{% extends 'admin/_layout.html.twig' %}

{% block title %}{{ proposal.name|e }} — Partenariat — Administration Devzair{% endblock %}

{% block body %}
{# ── Mappings humains (source unique pour ce template) ──────────────────── #}
{% set projectTypeLabels = {
    'vitrinesite': 'Site vitrine',
    'ecommerce':   'E-commerce',
    'businessapp': 'Application métier',
    'refonte':     'Refonte',
    'other':       'Autre projet',
    'unknown':     'Projet à cadrer'
} %}

{% set partnershipTypeLabels = {
    'revenue_share':  'Partage de revenus',
    'collaboration':  'Collaboration',
    'subcontracting': 'Sous-traitance',
    'referral':       'Apport d\'affaires',
    'other':          'Autre'
} %}

{% set projectStageLabels = {
    'idea':             'Idée',
    'validated_concept': 'Concept validé',
    'in_progress':      'En cours',
    'existing':         'Projet existant',
    'other':            'Autre'
} %}

{% set generatesRevenueLabels = {
    'yes':     'Oui',
    'no':      'Pas encore',
    'unknown': 'À discuter'
} %}

{% set partnershipStatusLabels = {
    'pending_review': 'À étudier'
} %}

{% set featureLabels = {
    'contact_form':       'Formulaire de contact',
    'content_management': 'Gestion de contenu',
    'booking':            'Prise de rendez-vous',
    'ecommerce':          'Boutique en ligne',
    'user_auth':          'Espace membres',
    'multilingual':       'Multilingue',
    'blog':               'Blog / actualités',
    'payment':            'Paiement en ligne',
    'api_integration':    'Intégration API',
    'custom_dashboard':   'Dashboard personnalisé'
} %}

{# ── Snapshots raccourcis ──────────────────────────────────────────────── #}
{% set snapshot = proposal.questionnaireSnapshot %}
{% set estimate = proposal.estimateSnapshot %}

{# ── Badge statut ──────────────────────────────────────────────────────── #}
{% set statusLabel = partnershipStatusLabels[proposal.status] ?? proposal.status|e %}

{# ── Hero / en-tête fiche ──────────────────────────────────────────────── #}
<div class="admin-detail-hero">
    <div class="admin-detail-hero__topbar">
        <a href="{{ path('admin_partnerships_list') }}" class="admin-detail-hero__back">&larr; Retour aux partenariats</a>
        <div class="admin-detail-hero__actions">
            <a href="mailto:{{ proposal.email|e }}" class="button-link button-small">
                Envoyer un email &nearr;
            </a>
        </div>
    </div>

    <h1 class="admin-detail-hero__name">{{ proposal.name|e }}</h1>
    {% if proposal.company %}
        <p class="admin-detail-hero__company">{{ proposal.company|e }}</p>
    {% endif %}

    <div class="admin-detail-hero__meta">
        <span>{{ projectTypeLabels[proposal.projectType] ?? proposal.projectType|e }}</span>
        <span aria-hidden="true">&middot;</span>
        <span class="admin-badge admin-badge--neutral">{{ statusLabel }}</span>
    </div>

    {% if proposal.estimateMinimumMinor is not null %}
        <p class="admin-detail-hero__range">
            {{ (proposal.estimateMinimumMinor / 100)|number_format(0, ',', ' ') }}&nbsp;&euro;
            &ndash;
            {{ (proposal.estimateMaximumMinor / 100)|number_format(0, ',', ' ') }}&nbsp;&euro;
        </p>
    {% endif %}

    <p class="admin-detail-hero__date">Reçu le {{ proposal.createdAt|date('d/m/Y à H:i') }}</p>
</div>

{# ── Grille deux colonnes : Coordonnées | Projet ─────────────────────── #}
<div class="admin-detail-grid">

    {# Colonne gauche : Coordonnées #}
    <div class="admin-card">
        <h2 class="admin-section-title">Coordonnées</h2>
        <dl class="admin-dl">
            <dt>Nom</dt>
            <dd>{{ proposal.name|e }}</dd>

            <dt>Email</dt>
            <dd><a href="mailto:{{ proposal.email|e }}">{{ proposal.email|e }}</a></dd>

            <dt>Téléphone</dt>
            <dd>
                {% if proposal.phone %}
                    <a href="tel:{{ proposal.phone|e }}">{{ proposal.phone|e }}</a>
                {% else %}
                    &mdash;
                {% endif %}
            </dd>

            <dt>Entreprise</dt>
            <dd>{{ proposal.company ? proposal.company|e : '—' }}</dd>
        </dl>
    </div>

    {# Colonne droite : Projet #}
    <div class="admin-card">
        <h2 class="admin-section-title">Projet</h2>
        <dl class="admin-dl">
            <dt>Type de projet</dt>
            <dd>{{ projectTypeLabels[proposal.projectType] ?? proposal.projectType|e }}</dd>

            <dt>Type de partenariat</dt>
            <dd>{{ partnershipTypeLabels[proposal.partnershipType] ?? proposal.partnershipType|e }}</dd>

            <dt>Stade du projet</dt>
            <dd>{{ projectStageLabels[proposal.projectStage] ?? proposal.projectStage|e }}</dd>

            <dt>Génère des revenus</dt>
            <dd>
                {% if proposal.generatesRevenue is not null %}
                    {{ generatesRevenueLabels[proposal.generatesRevenue] ?? proposal.generatesRevenue|e }}
                {% else %}
                    &mdash;
                {% endif %}
            </dd>

            <dt>Statut</dt>
            <dd><span class="admin-badge admin-badge--neutral">{{ statusLabel }}</span></dd>
        </dl>

        {# Fonctionnalités issues du snapshot #}
        {% if snapshot.features is defined and snapshot.features is not empty %}
            <p class="admin-section-title" style="margin-top:1rem;">Fonctionnalités</p>
            <ul class="admin-feature-list" aria-label="Fonctionnalités du projet">
                {% for feature in snapshot.features %}
                    <li class="admin-feature-chip">
                        {{ featureLabels[feature] ?? feature|e }}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>

{# ── Proposition (pleine largeur) ─────────────────────────────────────── #}
<div class="admin-card">
    <h2 class="admin-section-title">Proposition</h2>

    <p class="admin-card__title" style="margin-bottom:0.375rem;">
        {{ partnershipTypeLabels[proposal.partnershipType] ?? proposal.partnershipType|e }}
    </p>

    <blockquote class="admin-note-box">{{ proposal.proposalText|e }}</blockquote>

    {% if proposal.relevanceText %}
        <h3 style="font-size:0.875rem;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:var(--color-ink-muted);margin:1.25rem 0 0.5rem;">
            Pourquoi ce partenariat
        </h3>
        <blockquote class="admin-note-box">{{ proposal.relevanceText|e }}</blockquote>
    {% endif %}
</div>

{# ── Estimation (pleine largeur) ──────────────────────────────────────── #}
<div class="admin-card">
    <h2 class="admin-section-title">Estimation</h2>
    <dl class="admin-dl">
        <dt>Fourchette</dt>
        <dd>
            {% if proposal.estimateMinimumMinor is not null %}
                <span class="admin-estimate-range">
                    {{ (proposal.estimateMinimumMinor / 100)|number_format(0, ',', ' ') }}&nbsp;&euro;
                    &ndash;
                    {{ (proposal.estimateMaximumMinor / 100)|number_format(0, ',', ' ') }}&nbsp;&euro;
                </span>
            {% else %}
                &mdash;
            {% endif %}
        </dd>

        <dt>Version tarifaire</dt>
        <dd>{{ proposal.pricingVersion|e }}</dd>

        {% if estimate.recommended_project_type is defined and estimate.recommended_project_type is not empty %}
            <dt>Type recommandé</dt>
            <dd>{{ projectTypeLabels[estimate.recommended_project_type] ?? estimate.recommended_project_type|e }}</dd>
        {% endif %}

        {% if proposal.currency is not null %}
            <dt>Devise</dt>
            <dd>{{ proposal.currency|e }}</dd>
        {% endif %}
    </dl>

    {# Ventilation (breakdown) #}
    {% if estimate.breakdown is defined and estimate.breakdown is not empty %}
        <div class="admin-estimate-breakdown">
            <p class="admin-estimate-breakdown__title">Détail de l&rsquo;estimation</p>
            <table class="admin-estimate-breakdown__table" aria-label="Détail de l'estimation">
                <tbody>
                {% for item in estimate.breakdown %}
                    <tr>
                        <td>{{ item.label is defined ? item.label|e : '—' }}</td>
                        <td>
                            {% if item.min is defined and item.max is defined %}
                                {{ (item.min / 100)|number_format(0, ',', ' ') }}&nbsp;&euro;
                                &ndash;
                                {{ (item.max / 100)|number_format(0, ',', ' ') }}&nbsp;&euro;
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>

{# ── Lead associé (si présent) ────────────────────────────────────────── #}
{% if proposal.leadRequestId %}
<div class="admin-card">
    <h2 class="admin-section-title">Lead associé</h2>
    <dl class="admin-dl">
        <dt>Request ID</dt>
        <dd><code>{{ proposal.leadRequestId|e }}</code></dd>
    </dl>
</div>
{% endif %}

{# ── Données techniques (accordéon) ──────────────────────────────────── #}
<details class="admin-technical-details">
    <summary class="admin-technical-summary">Données techniques</summary>
    <div class="admin-technical-content">
        <p><strong>Request ID</strong>&nbsp;: <code>{{ proposal.requestId|e }}</code></p>
        <h3>Questionnaire brut</h3>
        <pre class="admin-json-preview">{{ proposal.questionnaireSnapshot|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE'))|e }}</pre>
        <h3>Estimation brute</h3>
        <pre class="admin-json-preview">{{ proposal.estimateSnapshot|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE'))|e }}</pre>
    </div>
</details>
{% endblock %}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Administration — Devzair{% endblock %}</title>
    {# Style externalisé pour permettre `style-src 'self'` sans `unsafe-inline` (voir ADR-012). #}
    <link rel="stylesheet" href="/admin/assets/admin.css">
</head>
<body>
    {% if is_granted('ROLE_ADMIN') %}
        <header class="admin-topbar">
            <nav class="admin-nav" aria-label="Navigation administration">
                <a href="{{ path('admin_dashboard') }}">Tableau de bord</a>
                <a href="{{ path('admin_articles_list') }}">Articles</a>
            </nav>
        </header>
    {% endif %}

    <main>
        {% for level, messages in app.flashes(['success', 'info', 'error']) %}
            {% for message in messages %}
                <div class="alert alert-{{ level }}" role="{{ level == 'error' ? 'alert' : 'status' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>
</body>
</html>

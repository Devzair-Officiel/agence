<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}Administration — Devzair{% endblock %}</title>
    {# Style externalisé pour permettre `style-src 'self'` sans `unsafe-inline` (voir ADR-012). #}
    <link rel="stylesheet" href="/admin/assets/admin.css">
</head>
<body>
{% set _is_admin = is_granted('ROLE_ADMIN') %}

{% if _is_admin %}
    {# ── Détection de la section active (route courante) ─────────────────── #}
    {% set _route = app.request.attributes.get('_route') %}
    {% set _nav_dashboard = _route == 'admin_dashboard' %}
    {% set _nav_articles  = 'admin_article' in _route %}
    {% set _nav_media     = 'admin_media'   in _route %}
    {% set _nav_pricing   = 'admin_pricing' in _route %}
    {% set _nav_leads    = 'admin_leads' in _route %}
    {% set _nav_partners = 'admin_partnerships' in _route %}

    {# ── Lien d'évitement (visible au focus clavier) ──────────────────────── #}
    <a class="admin-skip-link" href="#admin-main">Aller au contenu principal</a>

    {# ── Topbar mobile (masquée ≥ 1024 px) ───────────────────────────────── #}
    <header class="admin-topbar-mobile" role="banner">
        <div class="admin-topbar-mobile__brand" aria-hidden="true">
            <strong class="admin-brand-name">DEVZAIR</strong>
            <span class="admin-brand-sub">Admin</span>
        </div>

        <details class="admin-mobile-menu">
            <summary class="admin-mobile-menu__toggle">Menu</summary>

            <div class="admin-mobile-menu__panel">
                <ul class="admin-mobile-menu__list">
                    <li>
                        <a href="{{ path('admin_dashboard') }}"
                           class="admin-mobile-menu__link{% if _nav_dashboard %} admin-mobile-menu__link--active{% endif %}"
                           {% if _nav_dashboard %}aria-current="page"{% endif %}>
                            Tableau de bord
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_articles_list') }}"
                           class="admin-mobile-menu__link{% if _nav_articles %} admin-mobile-menu__link--active{% endif %}"
                           {% if _nav_articles %}aria-current="page"{% endif %}>
                            Articles
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_media_list') }}"
                           class="admin-mobile-menu__link{% if _nav_media %} admin-mobile-menu__link--active{% endif %}"
                           {% if _nav_media %}aria-current="page"{% endif %}>
                            Médias
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_pricing_list') }}"
                           class="admin-mobile-menu__link{% if _nav_pricing %} admin-mobile-menu__link--active{% endif %}"
                           {% if _nav_pricing %}aria-current="page"{% endif %}>
                            Tarification
                        </a>
                    </li>
                    {# Estimateur — leads et partenariats (EST-9) #}
                    <li>
                        <a href="{{ path('admin_leads_list') }}"
                           class="admin-mobile-menu__link{% if _nav_leads %} admin-mobile-menu__link--active{% endif %}"
                           {% if _nav_leads %}aria-current="page"{% endif %}>
                            Leads
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_partnerships_list') }}"
                           class="admin-mobile-menu__link{% if _nav_partners %} admin-mobile-menu__link--active{% endif %}"
                           {% if _nav_partners %}aria-current="page"{% endif %}>
                            Partenariats
                        </a>
                    </li>
                </ul>

                <div class="admin-mobile-menu__footer">
                    <a href="/" target="_blank" rel="noopener noreferrer"
                       class="admin-mobile-menu__site-link">
                        Voir le site ↗
                    </a>
                    <form method="post" action="{{ path('admin_logout') }}"
                          class="admin-mobile-menu__logout-form">
                        <input type="hidden" name="_csrf_token"
                               value="{{ csrf_token('logout') }}">
                        <button type="submit" class="admin-mobile-menu__logout-btn">
                            Déconnexion
                        </button>
                    </form>
                </div>
            </div>
        </details>
    </header>

    {# ── Shell desktop : sidebar persistante + workspace ─────────────────── #}
    <div class="admin-shell">

        {# Sidebar (masquée < 1024 px) #}
        <aside class="admin-sidebar" aria-label="Barre latérale d'administration">

            <div class="admin-sidebar__header">
                <strong class="admin-brand-name">DEVZAIR</strong>
                <span class="admin-brand-sub">Administration</span>
            </div>

            <nav class="admin-sidebar__nav" aria-label="Navigation">
                <ul class="admin-sidebar__list">
                    <li>
                        <a href="{{ path('admin_dashboard') }}"
                           class="admin-sidebar__link{% if _nav_dashboard %} admin-sidebar__link--active{% endif %}"
                           {% if _nav_dashboard %}aria-current="page"{% endif %}>
                            Tableau de bord
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_articles_list') }}"
                           class="admin-sidebar__link{% if _nav_articles %} admin-sidebar__link--active{% endif %}"
                           {% if _nav_articles %}aria-current="page"{% endif %}>
                            Articles
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_media_list') }}"
                           class="admin-sidebar__link{% if _nav_media %} admin-sidebar__link--active{% endif %}"
                           {% if _nav_media %}aria-current="page"{% endif %}>
                            Médias
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_pricing_list') }}"
                           class="admin-sidebar__link{% if _nav_pricing %} admin-sidebar__link--active{% endif %}"
                           {% if _nav_pricing %}aria-current="page"{% endif %}>
                            Tarification
                        </a>
                    </li>
                    {# Estimateur — leads et partenariats (EST-9) #}
                    <li>
                        <a href="{{ path('admin_leads_list') }}"
                           class="admin-sidebar__link{% if _nav_leads %} admin-sidebar__link--active{% endif %}"
                           {% if _nav_leads %}aria-current="page"{% endif %}>
                            Leads
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_partnerships_list') }}"
                           class="admin-sidebar__link{% if _nav_partners %} admin-sidebar__link--active{% endif %}"
                           {% if _nav_partners %}aria-current="page"{% endif %}>
                            Partenariats
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="admin-sidebar__footer">
                <div class="admin-sidebar__user">
                    <span class="admin-sidebar__user-name">{{ app.user.displayName }}</span>
                </div>
                <a href="/" target="_blank" rel="noopener noreferrer"
                   class="admin-sidebar__site-link">
                    Voir le site ↗
                </a>
                <form method="post" action="{{ path('admin_logout') }}"
                      class="admin-sidebar__logout-form">
                    <input type="hidden" name="_csrf_token"
                           value="{{ csrf_token('logout') }}">
                    <button type="submit" class="admin-sidebar__logout-btn">
                        Déconnexion
                    </button>
                </form>
            </div>
        </aside>

        {# Zone de travail principale #}
        <main class="admin-workspace" id="admin-main" tabindex="-1">
            <div class="admin-workspace__inner {% block workspace_inner_modifier %}{% endblock %}">{# trim #}

                {% for level, messages in app.flashes(['success', 'info', 'error']) %}
                    {% for message in messages %}
                        <div class="alert alert-{{ level }}"
                             role="{{ level == 'error' ? 'alert' : 'status' }}">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}

{% else %}
    {# ── Layout non-authentifié (page de connexion) ───────────────────────── #}
    <main class="admin-auth-wrapper">
        {% for level, messages in app.flashes(['success', 'info', 'error']) %}
            {% for message in messages %}
                <div class="alert alert-{{ level }}"
                     role="{{ level == 'error' ? 'alert' : 'status' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}
{% endif %}

{% block body %}{% endblock %}

{% if _is_admin %}
            </div>
        </main>

    </div>
{% else %}
    </main>
{% endif %}
</body>
</html>

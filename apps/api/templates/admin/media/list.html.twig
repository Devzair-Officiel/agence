{% extends 'admin/_layout.html.twig' %}

{% block title %}Médias éditoriaux — Administration Devzair{% endblock %}

{%- set _mime_labels = {
    'image/jpeg': 'JPEG',
    'image/png':  'PNG',
    'image/webp': 'WebP',
} -%}

{% block body %}
<div class="admin-media-page">

    <header class="admin-page-header">
        <div class="admin-page-header__titles">
            <h1 class="admin-page-header__title">Médias éditoriaux</h1>
            <p class="admin-page-header__subtitle">Gérez les images utilisées dans vos contenus.</p>
        </div>
        <div class="admin-page-header__actions">
            <a href="{{ path('admin_media_upload') }}" class="button-link button-primary">
                + Téléverser un média
            </a>
        </div>
    </header>

    {% if result.items is empty %}
        <div class="admin-media-empty empty-state">
            <p class="admin-media-empty__text">Aucun média pour le moment.</p>
            <p class="admin-media-empty__hint">
                Téléversez votre première image pour l'utiliser dans vos contenus.
            </p>
            <a href="{{ path('admin_media_upload') }}" class="button-link button-primary">
                + Téléverser un média
            </a>
        </div>
    {% else %}

        <div class="admin-media-header">
            <p class="admin-media-header__count">
                {{ result.total }} média{{ result.total > 1 ? 's' : '' }}
                — page {{ result.page }}/{{ result.lastPage() }}
            </p>
        </div>

        <ul class="admin-media-grid" role="list">
            {% for item in result.items %}
                {%- set _label      = 'Prévisualiser « ' ~ item.originalFilename ~ ' »' -%}
                {%- set _mime_human = _mime_labels[item.mimeType.value] ?? item.mimeType.value -%}
                {%- set _thumb_url  = item.hasVariants
                    ? path('admin_media_card',    { id: item.id })
                    : path('admin_media_preview', { id: item.id }) -%}
                {%- if item.sizeBytes >= 1048576 -%}
                    {%- set _size_human = (item.sizeBytes / 1048576)|number_format(1, ',', ' ') ~ ' Mio' -%}
                {%- else -%}
                    {%- set _size_human = (item.sizeBytes / 1024)|number_format(1, ',', ' ') ~ ' Kio' -%}
                {%- endif -%}
                <li class="admin-media-card">
                    <a href="{{ path('admin_media_preview', { id: item.id }) }}"
                       class="admin-media-card__preview"
                       aria-label="{{ _label }}">
                        <img src="{{ _thumb_url }}"
                             alt=""
                             class="admin-media-card__image"
                             width="{{ item.width }}"
                             height="{{ item.height }}"
                             loading="lazy">
                    </a>
                    <div class="admin-media-card__body">
                        <p class="admin-media-card__filename"
                           title="{{ item.originalFilename }}">{{ item.originalFilename }}</p>
                        <p class="admin-media-card__meta">
                            {{- item.width }}&thinsp;×&thinsp;{{ item.height }}&thinsp;px
                            &middot; {{ _mime_human }}
                            &middot; {{ _size_human }}
                            &middot; <time datetime="{{ item.createdAt|date('c') }}">{{ item.createdAt|date('d/m/Y') }}</time>
                        </p>
                        <p class="admin-media-card__usage">
                            {%- if item.usageCount > 0 -%}
                                <span class="badge badge--used"
                                      title="Utilisé par {{ item.usageCount }} article{{ item.usageCount > 1 ? 's' : '' }}">
                                    Utilisé ({{ item.usageCount }})
                                </span>
                            {%- else -%}
                                <span class="badge badge--unused">Non utilisé</span>
                            {%- endif -%}
                        </p>
                    </div>
                    {%- if item.usageCount == 0 -%}
                    <div class="admin-media-card__actions">
                        <form method="post"
                              action="{{ path('admin_media_delete', { id: item.id }) }}"
                              class="admin-media-card__delete-form"
                              onsubmit="return confirm('Supprimer définitivement « {{ item.originalFilename|e('js') }} » ? Cette action est irréversible.')">
                            <input type="hidden" name="_csrf_token"
                                   value="{{ csrf_token('media_delete_' ~ item.id) }}">
                            <button type="submit"
                                    class="button-danger-ghost"
                                    aria-label="Supprimer « {{ item.originalFilename }} »">
                                Supprimer
                            </button>
                        </form>
                    </div>
                    {%- endif -%}
                </li>
            {% endfor %}
        </ul>

        <nav class="admin-media-pagination" aria-label="Pagination des médias">
            <p class="admin-media-pagination__summary">
                Page {{ result.page }} sur {{ result.lastPage() }}
                — {{ result.total }} média{{ result.total > 1 ? 's' : '' }}
            </p>
            <ul class="admin-media-pagination__links">
                {% if result.hasPrevious() %}
                    <li>
                        <a href="{{ path('admin_media_list', { page: result.page - 1 }) }}">
                            ← Précédent
                        </a>
                    </li>
                {% endif %}
                {% if result.hasNext() %}
                    <li>
                        <a href="{{ path('admin_media_list', { page: result.page + 1 }) }}">
                            Suivant →
                        </a>
                    </li>
                {% endif %}
            </ul>
        </nav>
    {% endif %}

</div>
{% endblock %}

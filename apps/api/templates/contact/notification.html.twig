<!DOCTYPE html>
<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Nouvelle demande — Devzair</title>
  <!--[if mso]>
  <noscript>
    <xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml>
  </noscript>
  <![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#efebe2;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">

<!-- Outer wrapper -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#efebe2;min-width:100%;">
  <tr>
    <td align="center" style="padding:32px 16px;">

      <!-- Container 600px -->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;width:100%;">

        <!-- ── Header ── -->
        <tr>
          <td style="background-color:#0c5b57;border-radius:12px 12px 0 0;padding:28px 32px;text-align:center;">
            <p style="margin:0 0 5px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:rgba(244,241,234,0.6);">DEVZAIR</p>
            <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:19px;font-weight:700;letter-spacing:-0.01em;color:#f4f1ea;">Nouvelle demande de contact</p>
          </td>
        </tr>

        <!-- ── Main card ── -->
        <tr>
          <td style="background-color:#ffffff;padding:32px;border-radius:0 0 12px 12px;">

            <!-- Project type badge -->
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="padding-bottom:20px;">
                  <span style="display:inline-block;background-color:rgba(12,91,87,0.08);border:1px solid rgba(12,91,87,0.22);border-radius:6px;padding:6px 14px;font-family:'Courier New',Courier,monospace;font-size:10px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#0c5b57;">{{ projectType.label() }}</span>
                </td>
              </tr>
            </table>

            <!-- Intro text -->
            <p style="margin:0 0 28px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.6;color:#4a4e51;">Une nouvelle demande vient d'être envoyée depuis devzair.fr.</p>

            <!-- ── Section CONTACT ── -->
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:28px;">
              <tr>
                <td style="padding-bottom:10px;border-bottom:2px solid #0c5b57;">
                  <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#0c5b57;">Contact</p>
                </td>
              </tr>

              <!-- Nom -->
              <tr>
                <td style="border-bottom:1px solid #f4f1ea;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="100" style="padding:11px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#6e6a62;vertical-align:top;">Nom</td>
                      <td style="padding:11px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#16191c;vertical-align:top;">{{ name }}</td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- Email -->
              <tr>
                <td style="border-bottom:1px solid #f4f1ea;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="100" style="padding:11px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#6e6a62;vertical-align:top;">Email</td>
                      <td style="padding:11px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;vertical-align:top;">
                        <a href="mailto:{{ visitorEmail }}" style="color:#0c5b57;text-decoration:none;font-weight:600;">{{ visitorEmail }}</a>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- Société -->
              <tr>
                <td style="border-bottom:1px solid #f4f1ea;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="100" style="padding:11px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#6e6a62;vertical-align:top;">Société</td>
                      <td style="padding:11px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;vertical-align:top;">
                        {% if company %}
                          <span style="color:#16191c;">{{ company }}</span>
                        {% else %}
                          <span style="color:#b8b4ad;font-style:italic;">Non renseigné</span>
                        {% endif %}
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- Téléphone -->
              <tr>
                <td>
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="100" style="padding:11px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#6e6a62;vertical-align:top;">Téléphone</td>
                      <td style="padding:11px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;vertical-align:top;">
                        {% if telephone %}
                          <a href="tel:{{ telephone }}" style="color:#0c5b57;text-decoration:none;">{{ telephone }}</a>
                        {% else %}
                          <span style="color:#b8b4ad;font-style:italic;">Non renseigné</span>
                        {% endif %}
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <!-- ── Section PROJET ── -->
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:28px;">
              <tr>
                <td style="padding-bottom:10px;border-bottom:2px solid #0c5b57;">
                  <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:#0c5b57;">Projet</p>
                </td>
              </tr>

              <!-- Type -->
              <tr>
                <td style="border-bottom:1px solid #f4f1ea;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td width="100" style="padding:11px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#6e6a62;vertical-align:top;">Type</td>
                      <td style="padding:11px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;color:#16191c;vertical-align:top;">{{ projectType.label() }}</td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- Message -->
              <tr>
                <td style="padding-top:16px;">
                  <p style="margin:0 0 10px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#6e6a62;">Message</p>
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td style="background-color:#f8f5ef;border-left:3px solid #0c5b57;border-radius:0 6px 6px 0;padding:16px 20px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.7;color:#16191c;">
                        {{ message|nl2br }}
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>

            <!-- ── Référence ── -->
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="background-color:#f4f1ea;border-radius:8px;padding:18px 22px;">
                  <p style="margin:0 0 5px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#6e6a62;">Référence de la demande</p>
                  <p style="margin:0;font-family:'Courier New',Courier,monospace;font-size:22px;font-weight:700;letter-spacing:0.05em;color:#0c5b57;">#{{ shortId }}</p>
                </td>
              </tr>
            </table>

          </td>
        </tr>

        <!-- ── Footer ── -->
        <tr>
          <td style="padding:22px 32px;text-align:center;">
            <p style="margin:0 0 6px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.5;color:#9d9a93;">Consentement&#160;: Oui&#160;&#160;·&#160;&#160;Reçu le {{ receivedAtFormatted }}</p>
            <p style="margin:0 0 8px 0;font-family:'Courier New',Courier,monospace;font-size:10px;color:#c4cbd3;word-break:break-all;">ID technique&#160;: {{ requestId }}</p>
            <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;color:#b8b4ad;">Devzair&#160;·&#160;devzair.fr</p>
          </td>
        </tr>

      </table>
      <!-- /Container -->

    </td>
  </tr>
</table>

</body>
</html>

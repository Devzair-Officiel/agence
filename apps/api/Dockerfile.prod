# Devzair — API Symfony 7.4 LTS production (Phase 12)
#
# Runtime : FrankenPHP (PHP 8.4-alpine) — migration depuis php -S confirmée
# par ADR-006 au premier domaine persistant (Phase 8). FrankenPHP est le
# runtime préféré, servi directement sur :8000 derrière le Caddy global du VPS.
#
# Ce Dockerfile ne doit JAMAIS être utilisé en dev.
#
# Volumes attendus au démarrage (voir compose.prod.yaml) :
#   api_sessions → /app/var/sessions     (sessions filesystem admin)
#   api_media    → /app/var/editorial-media  (médias éditoriaux)
#
# var/cache/prod/ est généré par docker-entrypoint.sh au démarrage du conteneur
# (cache:warmup avec les vraies env vars Docker — voir docker/frankenphp/docker-entrypoint.sh).

FROM dunglas/frankenphp:php8.4-alpine

# Extensions identiques à Dockerfile.dev + FrankenPHP utilise
# install-php-extensions pour gérer les dépendances système automatiquement.
RUN install-php-extensions \
        exif \
        gd \
        intl \
        opcache \
        pdo_pgsql \
        pgsql \
        zip

COPY --from=composer:2.8 /usr/bin/composer /usr/bin/composer

WORKDIR /app

# ── Dépendances Composer (couche cachée) ─────────────────────────────────────
# --no-autoloader : le classmap sera généré après COPY du code applicatif
# pour inclure App\** dans l'autoloader (fix : App\Kernel not found).
COPY composer.json composer.lock symfony.lock ./
RUN APP_ENV=prod composer install \
        --no-dev \
        --no-autoloader \
        --no-interaction \
        --no-scripts \
        --prefer-dist \
        --no-progress

# ── Code applicatif ───────────────────────────────────────────────────────────
COPY . .

# Génère le classmap-authoritative APRÈS que tout le code est présent.
RUN APP_ENV=prod APP_DEBUG=0 composer dump-autoload \
        --no-dev \
        --classmap-authoritative \
        --no-interaction

# ── Configuration PHP ─────────────────────────────────────────────────────────
COPY docker/php/editorial-media.ini /usr/local/etc/php/conf.d/zz-editorial-media.ini
COPY docker/php/opcache.prod.ini    /usr/local/etc/php/conf.d/zz-opcache.ini

# ── FrankenPHP Caddyfile + entrypoint ─────────────────────────────────────────
COPY docker/frankenphp/Caddyfile            /etc/caddy/Caddyfile
COPY docker/frankenphp/docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN chmod +x /usr/local/bin/docker-entrypoint

# ── Permissions non-root ──────────────────────────────────────────────────────
# FrankenPHP (Caddy intégré) écrit dans /data et /config pour la gestion
# des certificats. Avec auto_https off, seul /data/caddy est écrit.
# Les sessions et médias sont sur volumes séparés (voir compose.prod.yaml).
# var/cache est créé par l'entrypoint au démarrage avec les vraies env vars.
RUN addgroup -g 1001 -S symfony && \
    adduser  -u 1001 -S symfony -G symfony && \
    mkdir -p \
        /app/var/cache \
        /app/var/sessions \
        /app/var/log \
        /app/var/editorial-media \
        /data/caddy \
        /config/caddy && \
    chown -R symfony:symfony \
        /app/var \
        /data/caddy \
        /config/caddy

USER symfony

EXPOSE 8000

ENV APP_ENV=prod
ENV APP_DEBUG=0
# En production, toutes les variables d'environnement proviennent du runtime
# Docker (compose.prod.yaml / .env.prod injecté par l'opérateur). Le fichier
# .env de Symfony est un outil de développement ; Symfony Runtime tente de le
# charger même quand APP_ENV=prod est déjà défini dans le process, ce qui
# lève PathException si le fichier est absent du conteneur.
#
# APP_RUNTIME_OPTIONS={"disable_dotenv":true} ordonne à Symfony Runtime de
# court-circuiter intégralement le chargement DotEnv (Dotenv::bootEnv n'est
# jamais appelé). bin/console et public/index.php lisent alors directement
# $_SERVER / $_ENV alimenté par Docker — aucun .env n'est lu ni requis.
#
# Cette option est intentionnelle et propre à l'image de production.
# Ne PAS l'ajouter dans compose.yaml (dev) ni dans Dockerfile.dev.
ENV APP_RUNTIME_OPTIONS='{"disable_dotenv":true}'

# ── Vérifications build-time (sans secrets) ───────────────────────────────────
# Les variables de production (DATABASE_URL, APP_SECRET, MAILER_DSN, etc.)
# ne sont jamais disponibles au BUILD — elles sont injectées uniquement au
# RUNTIME par compose.prod.yaml / .env.prod. On ne peut donc pas exécuter
# bin/console here. Le test Symfony complet (cache:warmup, about, healthcheck)
# se fait au RUNTIME via docker-entrypoint.sh et le HEALTHCHECK.
#
# Ce RUN vérifie uniquement les invariants statiques de l'image :
#   1. APP_RUNTIME_OPTIONS est du JSON strict avec disable_dotenv=true.
#   2. /app/.env est absent (aucun secret embarqué dans l'image).
RUN php -r '$o=json_decode(getenv("APP_RUNTIME_OPTIONS"),true); json_last_error()===JSON_ERROR_NONE&&!empty($o["disable_dotenv"])||die("ERROR: APP_RUNTIME_OPTIONS invalide: ".getenv("APP_RUNTIME_OPTIONS").PHP_EOL); echo "OK: APP_RUNTIME_OPTIONS JSON strict valide\n";' && \
    test ! -f /app/.env || { echo "ERROR: /app/.env present dans l image — secrets interdits" && exit 1; } && \
    echo "OK: /app/.env absent de l image"

# start_period étendu à 60 s pour laisser le temps au cache:warmup de l'entrypoint.
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 CMD wget -q --spider --tries=1 http://localhost:8000/health || exit 1

ENTRYPOINT ["docker-entrypoint"]
CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]

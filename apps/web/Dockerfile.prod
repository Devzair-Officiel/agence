# Devzair — Nuxt 4 production (Phase 12)
#
# Multi-stage :
#   builder  — npm ci + npm run build → génère .output/
#   runtime  — copie uniquement .output/, démarre Nitro en non-root
#
# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  VARIABLES INJECTÉES AU BUILD — POURQUOI C'EST NÉCESSAIRE              ║
# ║                                                                          ║
# ║  Nuxt 4 pré-rend certaines pages lors de `npm run build`               ║
# ║  (routeRules prerender: true — cf. nuxt.config.ts) :                   ║
# ║    /   /agence   /contact   /expertises                                 ║
# ║                                                                          ║
# ║  useRuntimeConfig() est appelé pendant ce pré-rendu.                   ║
# ║  Si NUXT_PUBLIC_SITE_URL n'est pas dans l'environnement du builder,    ║
# ║  Nuxt utilise sa valeur par défaut ("http://localhost:3001") et         ║
# ║  bake les URLs incorrectes dans le HTML statique :                      ║
# ║    <link rel="canonical" href="http://localhost:3001/">                 ║
# ║    <meta property="og:url" content="http://localhost:3001/">            ║
# ║    JSON-LD Organization/WebSite avec http://localhost:3001              ║
# ║    <meta name="robots" content="noindex, nofollow">                    ║
# ║                                                                          ║
# ║  Ces valeurs sont dans le HTML servi aux crawlers SEO. Elles ne        ║
# ║  peuvent PAS être corrigées à runtime (pages statiques).               ║
# ║                                                                          ║
# ║  Solution : passer les 3 valeurs via ARG → ENV avant npm run build.    ║
# ║  Elles ne sont PAS copiées dans le stage runtime (isolation).          ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ─── Stage 1 : build ────────────────────────────────────────────────────────
FROM node:24-alpine AS builder

WORKDIR /app

# Dépendances d'abord (couche cachée tant que package(-lock).json ne change pas).
COPY package.json package-lock.json ./
RUN npm ci

# Code applicatif.
COPY . .

# Valeurs SEO nécessaires au pré-rendu. Fournies par compose.prod.yaml via
# `build.args` (elles-mêmes lues depuis .env.prod). Valeurs de sécurité par
# défaut intentionnellement incorrectes : le build échoue si elles ne sont
# pas surchargées par le vrai domaine (voir le contrôle ci-dessous).
ARG NUXT_PUBLIC_SITE_URL=http://localhost:3001
ARG NUXT_PUBLIC_SITE_INDEXABLE=false
ARG NUXT_PUBLIC_API_BASE_URL=/api
# Turnstile : site-key PUBLIQUE uniquement — jamais TURNSTILE_SECRET ici.
# /contact est pré-rendue avec prerender:true ; useRuntimeConfig() est résolu
# au build. Sans ces ARGs, le HTML embarque turnstileEnabled:false et
# turnstileSiteKey:"", et Turnstile reste inactif même en production.
ARG NUXT_PUBLIC_TURNSTILE_SITE_KEY
ARG NUXT_PUBLIC_TURNSTILE_ENABLED=false

ENV NUXT_PUBLIC_SITE_URL=$NUXT_PUBLIC_SITE_URL
ENV NUXT_PUBLIC_SITE_INDEXABLE=$NUXT_PUBLIC_SITE_INDEXABLE
ENV NUXT_PUBLIC_API_BASE_URL=$NUXT_PUBLIC_API_BASE_URL
ENV NUXT_PUBLIC_TURNSTILE_SITE_KEY=$NUXT_PUBLIC_TURNSTILE_SITE_KEY
ENV NUXT_PUBLIC_TURNSTILE_ENABLED=$NUXT_PUBLIC_TURNSTILE_ENABLED

RUN npm run build

# ── Contrôles reproductibles du HTML pré-rendu ───────────────────────────────
# / — URL canonique correcte, aucun localhost.
RUN test -f .output/public/index.html || \
      { echo "ERROR: .output/public/index.html absent — / n'est pas pré-rendue." && exit 1; } && \
    grep -qF "${NUXT_PUBLIC_SITE_URL}" .output/public/index.html || \
      { echo "ERROR: canonical/OG absent dans /. Attendu: ${NUXT_PUBLIC_SITE_URL}" && exit 1; } && \
    ! grep -qF "localhost" .output/public/index.html || \
      { echo "ERROR: 'localhost' dans le HTML pré-rendu de /. NUXT_PUBLIC_SITE_URL non surchargée ?" && exit 1; } && \
    echo "SEO check OK — canonical et OG contiennent ${NUXT_PUBLIC_SITE_URL}"

# /contact — Turnstile activé avec site-key non vide.
# TURNSTILE_SECRET n'est jamais déclaré comme ARG ici : le backend Symfony
# l'injecte exclusivement dans le service api (compose.prod.yaml).
RUN test -f .output/public/contact/index.html || \
      { echo "ERROR: .output/public/contact/index.html absent — /contact n'est pas pré-rendue." && exit 1; } && \
    ! grep -qF 'turnstileEnabled:false' .output/public/contact/index.html || \
      { echo "ERROR: turnstileEnabled:false dans /contact. NUXT_PUBLIC_TURNSTILE_ENABLED non surchargée ?" && exit 1; } && \
    ! grep -qF 'turnstileSiteKey:""' .output/public/contact/index.html || \
      { echo "ERROR: turnstileSiteKey vide dans /contact. NUXT_PUBLIC_TURNSTILE_SITE_KEY non surchargée ?" && exit 1; } && \
    echo "Turnstile check OK — turnstileEnabled:true et site-key presente dans /contact"

# ─── Stage 2 : runtime minimal ───────────────────────────────────────────────
# Les ARG du stage builder ne sont PAS propagés ici (isolation multi-stage).
# Les valeurs runtime sont injectées par compose.prod.yaml via `environment:`.
FROM node:24-alpine AS runtime

RUN addgroup -S nuxt && adduser -S nuxt -G nuxt

WORKDIR /app

# Seul .output est nécessaire en production.
COPY --from=builder --chown=nuxt:nuxt /app/.output ./.output

USER nuxt

EXPOSE 3000

ENV NODE_ENV=production
ENV NITRO_HOST=0.0.0.0
ENV NITRO_PORT=3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 CMD wget -q --spider --tries=1 http://127.0.0.1:3000/ || exit 1

CMD ["node", ".output/server/index.mjs"]

# Devzair — variables d'environnement publiques et backend (Phase 6A)
#
# Copier en .env avant `docker compose up` :
#   cp .env.example .env
#
# Ces valeurs alimentent deux services :
# - `web` (Nuxt)      : les variables préfixées NUXT_PUBLIC_* atterrissent
#                       dans runtimeConfig.public.
# - `api` (Symfony)   : les autres variables sont lues par bin/console et le
#                       front controller. Aucun secret n'est stocké ici :
#                       les vrais secrets doivent aller dans un .env.local ou
#                       un secret manager en production.

# ---------------------------------------------------------------------------
# Front — Nuxt
# ---------------------------------------------------------------------------

# URL absolue publique du site — sert de base à tous les canonicals, aux
# URLs Open Graph et au sitemap. Doit être une URL http(s):// sans slash final.
# En production, remplacer par l'URL réelle (ex. https://devzair.fr).
NUXT_PUBLIC_SITE_URL=http://localhost:3001

# Politique d'indexation globale du site.
#   - `false` (défaut) : @nuxtjs/robots impose noindex, nofollow sur toutes
#     les réponses HTML (X-Robots-Tag + meta), robots.txt bloque tout crawl.
#     À utiliser en dev, en preprod, et à chaque fois que le contenu n'est
#     pas prêt à être publié.
#   - `true` : le site est indexable ; les pages marquées `noindex` en
#     configuration usePageSeo restent noindex individuellement.
# Le défaut sécurisé est `false` pour empêcher toute preprod de devenir
# indexable par oubli de variable.
NUXT_PUBLIC_SITE_INDEXABLE=false

# Base URL de l'API. Le navigateur appelle /api/... et Caddy route vers le
# conteneur Symfony. Ne pas préfixer avec un domaine : garder relatif pour
# ne jamais introduire de CORS interne.
NUXT_PUBLIC_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# Backend — Symfony (API contact)
# ---------------------------------------------------------------------------

# Environnement d'exécution Symfony. `dev` en local, `prod` en production.
APP_ENV=dev
APP_DEBUG=1
# Utilisé pour signer les cookies internes. Aucun cookie n'est émis par
# l'API en Phase 6A (endpoint stateless), mais la valeur reste requise par
# le framework. Générer une valeur forte en production.
APP_SECRET=changeme_local_dev_only_never_used_for_signing

# DSN Symfony Mailer.
#   - `null://null` (défaut sûr) : aucun email envoyé. Utilisé en dev, test
#     et preprod tant que la boîte de réception réelle n'est pas prête.
#   - `smtp://user:pass@host:port` en production, fournir via secret manager.
MAILER_DSN=null://null
CONTACT_FROM_EMAIL=no-reply@devzair.example
CONTACT_FROM_NAME="Devzair — Site"
# Destinataire du formulaire. En prod, valeur obligatoire — sinon l'API
# renvoie 503 pour éviter d'accepter un message qui sera silencieusement
# perdu. Laisser vide en dev tant qu'aucune boîte n'est branchée.
CONTACT_RECIPIENT=

# Cloudflare Turnstile — vérification serveur du token émis par le widget.
#   - `false` en dev/test : implémentation `AlwaysAllow` (accepte tout).
#   - `true` en production, avec un secret valide fourni via secret manager.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=

# Rate limit par IP réelle. Défaut : 5 requêtes / 10 minutes.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_INTERVAL="10 minutes"

# Liste blanche d'Origin acceptés (séparés par virgule). Une requête sans
# Origin correspondant est rejetée en 403. Politique CSRF stateless — voir
# docs/adr/ADR-007-endpoint-contact-securite.md.
CONTACT_ORIGIN_ALLOWLIST=http://localhost:3001

# Trusted proxies (Caddy est en frontal → Symfony doit lui faire confiance
# pour X-Forwarded-*). En Docker Compose, `REMOTE_ADDR` couvre l'IP dynamique
# du réseau bridge.
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-host

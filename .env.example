# Devzair — variables d'environnement publiques
#
# Copier en .env avant `docker compose up` :
#   cp .env.example .env
#
# Ces valeurs alimentent runtimeConfig.public dans apps/web/nuxt.config.ts.
# NE JAMAIS ajouter ici de secret (clé API, mot de passe, jeton signé).
# Les secrets serveur iront dans runtimeConfig (sans .public) et devront
# rester hors du dépôt.

NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_API_BASE_URL=/api

# =============================================================================
# Devzair — Template d'environnement
# =============================================================================
#
# Copier ce fichier en `.env` à la racine du projet avant `docker compose up` :
#   cp .env.example .env
#
# Ce `.env` racine est le SEUL fichier de configuration actif en dev local :
#   - Docker Compose y lit les variables pour la substitution `${VAR}` de
#     compose.yaml et l'injection dans les conteneurs (env_file).
#   - Le service `web` (Nuxt) reçoit toutes les variables `NUXT_PUBLIC_*`.
#   - Le service `api` (Symfony) reçoit les autres, qui écrasent la cascade
#     `.env` interne de Symfony (apps/api/.env reste minimal).
#
# En production :
#   - `.env` n'est PAS déployé. Les valeurs viennent d'un secret manager ou
#     de variables d'environnement systemd / K8s.
#   - Ne jamais commiter un fichier contenant un vrai secret.
#
# Cascade Symfony (rappel) :
#   .env → .env.local → .env.$APP_ENV → .env.$APP_ENV.local
#   Les .env.local et .env.*.local sont gitignorés.
# =============================================================================

# -----------------------------------------------------------------------------
# Front — Nuxt / Nitro
# -----------------------------------------------------------------------------

# URL absolue publique du site (canonicals, Open Graph, sitemap). Sans slash final.
# En prod : https://devzair.fr
NUXT_PUBLIC_SITE_URL=http://localhost:3001

# Indexation globale. `false` (défaut sûr) = noindex + robots.txt bloquant.
# Passer à `true` uniquement en production ou pour un test de rendu SEO.
NUXT_PUBLIC_SITE_INDEXABLE=false

# Base URL publique de l'API vue par le navigateur (Caddy route /api/**).
NUXT_PUBLIC_API_BASE_URL=/api

# Base URL PRIVÉE utilisée par Nitro en SSR pour appeler Symfony sans Caddy.
# Voir ADR-011.
NUXT_EDITORIAL_API_BASE_URL=http://api:8000

# Cloudflare Turnstile — clé publique (site-key). Vide en dev = widget dev-noop
# qui émet un token factice accepté par AlwaysAllowTurnstileVerifier.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Interrupteur front Turnstile. false = aucun script Cloudflare chargé.
# Doit rester aligné avec TURNSTILE_ENABLED côté API.
NUXT_PUBLIC_TURNSTILE_ENABLED=false

# -----------------------------------------------------------------------------
# Backend — Symfony
# -----------------------------------------------------------------------------

APP_ENV=dev
APP_DEBUG=1

# Secret Symfony (signature cookie session admin, HttpFoundation).
# En prod : `openssl rand -hex 32` et injection via secret manager.
APP_SECRET=changeme_local_dev_only_never_used_for_signing

# -----------------------------------------------------------------------------
# Mailer + Cloudflare Turnstile côté serveur
# -----------------------------------------------------------------------------

# DSN Mailer. `null://null` = aucun mail envoyé (défaut sûr en dev/test).
# En prod, exemple OVH :
#   MAILER_DSN=smtp://USER:MOT_DE_PASSE@ssl0.ovh.net:465?encryption=ssl
MAILER_DSN=null://null

CONTACT_FROM_EMAIL=no-reply@devzair.example
CONTACT_FROM_NAME="Devzair — Site"
# Destinataire du formulaire. En prod : obligatoire, sinon 503.
CONTACT_RECIPIENT=

# Vérification serveur Turnstile. false = AlwaysAllow (accepte tout).
# En prod : true + TURNSTILE_SECRET fourni par le secret manager.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=

# -----------------------------------------------------------------------------
# Rate limit + CORS + trusted proxies
# -----------------------------------------------------------------------------

CONTACT_RATE_LIMIT=5
CONTACT_RATE_INTERVAL="10 minutes"

CONTACT_ORIGIN_ALLOWLIST=http://localhost:3001

TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-host

# -----------------------------------------------------------------------------
# PostgreSQL (Compose + Doctrine)
# -----------------------------------------------------------------------------
#
# Le service `postgres` est verrouillé sur 17-alpine (voir ADR-009). Le mot de
# passe ci-dessous n'est valable qu'en local — en prod, via secret manager.
POSTGRES_DB=devzair
POSTGRES_USER=devzair
POSTGRES_PASSWORD=devzair_local_password

DATABASE_URL="postgresql://devzair:devzair_local_password@postgres:5432/devzair?serverVersion=17&charset=utf8"

# -----------------------------------------------------------------------------
# Administration Symfony (Phase 8C1, cf. ADR-012)
# -----------------------------------------------------------------------------

# Durée de vie de la session admin (secondes, défaut 8h).
ADMIN_SESSION_LIFETIME=28800
# Throttling natif Symfony sur /admin/login.
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_INTERVAL="15 minutes"

# -----------------------------------------------------------------------------
# Média éditorial + upload admin (Phase 9A)
# -----------------------------------------------------------------------------

EDITORIAL_MEDIA_STORAGE_DIR=/app/var/editorial-media
ADMIN_MEDIA_UPLOAD_LIMIT=20
ADMIN_MEDIA_UPLOAD_INTERVAL="10 minutes"

# -----------------------------------------------------------------------------
# Intégration n8n — création automatisée de brouillons d'article
# -----------------------------------------------------------------------------

# Token secret partagé avec le workflow n8n. Générer par exemple avec :
#   openssl rand -hex 32
# Vide = l'endpoint refuse toutes les requêtes.
N8N_EDITORIAL_TOKEN=
